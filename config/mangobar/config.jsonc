{
	"layer": "top",
	"height": 32,
	"buffer-scale": 1,
	
	"modules-left": ["workspaces"],

 	"modules-center": ["window"],

	"modules-right": [
		"custom/updates",
		"tray",
		"pulseaudio",
		"network",
		"clock#time"
	],

	"workspaces": {
	    "pinned": [1, 2, 3],
	    "tag-names": ["", "", ""],
		"on-click": "activate",
		"on-click-right": "toggle",
		"scroll-interval": 100,
		"on-scroll-up": "mmsg dispatch viewtoleft_have_client",
        "on-scroll-down": "mmsg dispatch viewtoright_have_client"
	},

	"window": {
    	"format": "{}",
    	"max-length": 500
	},

	"custom/updates": {
	    "exec": "$HOME/.config/mangobar/scripts/checkupdates",
	   	"format": "",
		"return-type": "json",
	    "interval": 3600,
	    "signal": 8,
	    "on-click": "$HOME/.scripts/update"
	},

	"tray": {
    	"icon-size": 18,
    	"spacing": 8
	},
	
	"pulseaudio": {
	    "format": "{icon}",
	    "format-muted": "\u00A0󰕿\u00A0",
	    "icons": ["󰖀", "󰕾"],
	    "icon-bluetooth": "󰂯",
	    "scroll-step": 1,
	    "max-volume": 100,
	    "on-click": "pavucontrol"
	},

	"network": {
	    "format": "{icon}",
	    "format-wifi": "{signal} {ssid}",
	    "format-disconnected": "{icon}",
	    "icon-wifi": "󰖩",
	    "icon-ethernet": "󰈀\u00A0",
	    "icon-disconnected": "󰖪",
	    "signal-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
	    "on-click": "nm-connection-editor"
	},

	"clock#time": {
	    "format": "{:L%H:%M}",
	    "on-click": "foot -e calcurse"
	}
}
