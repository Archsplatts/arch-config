{
   	"custom/updates": {
    	"format": "{0}{icon}",
    	"return-type": "json",
    	"interval": 7200,
		"icon": true,
    	"signal": 1, 
    	"format-icons": {
        	"has-updates": "\u00A0",
        	"updated": ""
    },
    	"exec": "$HOME/.scripts/checkupdates",
		"on-click": "$HOME/.scripts/update",
    	"on-click-right": "$HOME/.scripts/reload"
	}
}	
