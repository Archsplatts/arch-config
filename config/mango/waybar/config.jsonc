{
	"include": [
		"$HOME/.config/mango/waybar/modules/window.jsonc",
		"$HOME/.config/mango/waybar/modules/workspaces.jsonc",
		"$HOME/.config/mango/waybar/modules/custom-updates.jsonc",
		"$HOME/.config/mango/waybar/modules/tray.jsonc",
		"$HOME/.config/mango/waybar/modules/pulseaudio.jsonc",
		"$HOME/.config/mango/waybar/modules/network.jsonc",
		"$HOME/.config/mango/waybar/modules/clock.jsonc"
	],

	"layer": "top",
	"position": "bottom",
	"height": 32,
	"spacing": 0,
	"reload_style_on_change": true,
	
	"modules-left": ["mango/workspaces"],

	"modules-center": ["mango/window"],
	
	"modules-right": [
		"custom/updates",
		"tray",
		"pulseaudio",
		"network",
		"clock" ]
}
