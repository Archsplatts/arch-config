#!/bin/bash

# Afficher le menu et capturer la sélection
selection=$(echo -e " Mettre à jour\n Maintenance\n󰣇 Lire les news Archlinux\n󰓅 Rafraichir les miroirs\n󰁯 Sauvegarde Timeshift" | rofi -dmenu -config ~/.config/rofi/system-menu.rasi)

# Vérifier si une sélection a été faite
if [[ -n "$selection" ]]; then
    case "$selection" in
		" Mettre à jour")
			foot sh -c "yay -Syu || true; echo; read -n 1 -s -p 'Appuyez sur une touche pour quitter...'"
			;;
    	" Maintenance")
    		foot sh -c "$HOME/.scripts/maintenance || true; echo; read -n 1 -s -p 'Appuyez sur une touche pour quitter...'"
            ;;
		"󰣇 Lire les news Archlinux")
			brave-origin "https://archlinux.org"
			;;
        "󰓅 Rafraichir les miroirs")
        	foot sh -c "sudo reflector --country France,Germany --latest 5 --age 12 --protocol https --sort rate --save /etc/pacman.d/mirrorlist --verbose|| true; echo; read -n 1 -s -p 'Appuyez sur une touche pour quitter...'"
			;;
        "󰁯 Sauvegarde Timeshift")
            foot sh -c "sudo timeshift --create || true; echo; read -n 1 -s -p 'Appuyez sur une touche pour quitter...'"
            ;;
    esac
fi   
